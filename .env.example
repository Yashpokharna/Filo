# Public URL of this storefront (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.filoclothing.com

# Shopify store domain that serves products.json and hosts checkout.
# Keep www.filoclothing.com until the domain moves to this app; afterwards
# point it at the store's Shopify domain (e.g. shop.filoclothing.com).
NEXT_PUBLIC_SHOPIFY_DOMAIN=www.filoclothing.com

# Optional — enables the contact form and newsletter to email the team via
# Resend (https://resend.com). Without these, both forms open the visitor's
# email app addressed to hello@filoclothing.com instead.
RESEND_API_KEY=
MAIL_FROM="Filo Website <website@filoclothing.com>"
MAIL_TO=hello@filoclothing.com
